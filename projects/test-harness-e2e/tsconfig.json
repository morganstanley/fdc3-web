{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": false,
        "sourceMap": true
    },
    "include": ["src/**/*.ts", "playwright.config.ts"]
}
